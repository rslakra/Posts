#
# App Configs
#
ENV_TYPE = develop
DEBUG = False
HOST = <APP_HOST> # HOST = 127.0.0.1
PORT = <APP_PORT> # PORT = 8080
#
# Pool Configs
#
DEFAULT_POOL_SIZE = <DEFAULT_POOL_SIZE> # DEFAULT_POOL_SIZE = 1
RDS_POOL_SIZE = <RDS_POOL_SIZE> # RDS_POOL_SIZE = 1
#
# Logger Configs
#
LOG_FILE_NAME = 'iws.log'
#
# Database Configs
#
# DB_TYPE = SQLAlchemy (SQLite file database) OR MYSQL (see 'make db-up')
DB_TYPE = SQLAlchemy
# Optional SQLite file path override (SQLAlchemy only). Supports relative or absolute paths.
# DB_PATH = data/posts.db
DB_HOSTNAME = <DB_HOSTNAME> # DB_HOSTNAME = 127.0.0.1
DB_PORT = <DB_PORT>  # DB_PORT = 3306 (MYSQL only)
DB_NAME = <DB_NAME> # DB_NAME = posts
DB_USERNAME = <DB_USERNAME>  # DB_USERNAME = posts
DB_PASSWORD = <DB_PASSWORD>  # DB_PASSWORD = Password
#
# Security Configs
#
ENC_KEY = <ENC_KEY>
ENC_NONCE = <ENC_NONCE>
